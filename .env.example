# Database
#
# Do not set DATABASE_URL here. Rails applies it to every environment and it
# overrides the per environment entries in config/database.yml, so RAILS_ENV=test
# would connect to the development database and every rspec run would truncate
# your development data.
#
# config/database.yml already names a separate database per environment:
#   development: homeschool_api_development
#   test:        homeschool_api_test
# Run `bin/rails db:prepare` for development and
# `RAILS_ENV=test bin/rails db:prepare` for test.
#
# Production sets DATABASE_URL in the host environment, where this file is never
# loaded: dotenv-rails is limited to the development and test groups.

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRY=3600 # 1 hour
JWT_REFRESH_TOKEN_EXPIRY=2592000 # 720 hours (30 days)

# App
APP_HOST=http://localhost:3000
FRONTEND_URL=http://localhost:8081

# Email (Resend SMTP)
RESEND_API_KEY=placeholder